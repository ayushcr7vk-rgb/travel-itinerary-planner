# ==============================================================================
# TRAVEL ITINERARY PLANNER - BACKEND CONFIGURATION
# ==============================================================================

# Google Gemini API Key (Optional)
# Leave blank to run in Demo Mode with realistic pre-curated destination itineraries.
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model Selection (Defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Supabase Credentials (Optional)
# Leave blank to run in Local Storage Mode (saves to backend/data/local_trips.json).
# Get project URL and anon/service key from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
SUPABASE_KEY=

# Server Port
PORT=8000
